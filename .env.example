# Copy to .env for LOCAL runs only. On the host, set these as environment variables.
DISCORD_TOKEN=
# none (default) | guild | global.  Sync slash commands once after first deploy or when
# commands change, then set back to none (syncing on every start can get rate-limited).
SYNC_COMMANDS=none
# Only for SYNC_COMMANDS=guild: your test server's ID (instant updates while developing).
DEV_GUILD_ID=
# Optional: https link shown as a Support button in /help and /about.
SUPPORT_URL=
# Where /stats counters are saved. Empty = memory only.
STATS_PATH=data/stats.json
